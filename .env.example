# Copy to .env and fill in. Every variable is optional; with none set the app runs in demo mode.

# --- AI extraction, translation and LIVE scheme search ---
# Live search of official websites needs Gemini (Google Search grounding). Set LLM_PROVIDER=gemini.
LLM_PROVIDER=auto            # auto | anthropic | openai | gemini | groq | compatible | none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash   # change if Google retires this name
# Groq: free tier, no card needed, fast. Has no web search, so pair it with TAVILY_API_KEY below for live search.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile   # model names change; check console.groq.com
# Any other OpenAI-style service (OpenRouter, Together, Mistral, Cerebras...): set LLM_PROVIDER=compatible
COMPATIBLE_API_KEY=
COMPATIBLE_BASE_URL=https://openrouter.ai/api/v1
COMPATIBLE_MODEL=
JSON_MODE=true               # set false if a model rejects JSON mode
LLM_TIMEOUT_SECONDS=90
MAX_EXTRACT_CHARS=150000     # defaults to 20000 for groq/compatible because of small per-minute caps

# --- Voice ---
TTS_PROVIDER=gtts            # gtts | elevenlabs | openai | none
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
OPENAI_TTS_MODEL=tts-1
TTS_TIMEOUT_SECONDS=20

# --- Documents ---
MAX_UPLOAD_MB=10
# Comma separated host suffixes for "paste a link". Empty means any public website.
ALLOWED_URL_SUFFIXES=.gov.in,.nic.in

# --- Optional fallback live search (only used when there is no Gemini key; results limited to gov.in / nic.in) ---
SEARCH_PROVIDER=auto         # auto | tavily | brave | none
TAVILY_API_KEY=
BRAVE_API_KEY=
SEARCH_TIMEOUT_SECONDS=10

# --- Public deployment protection (per visitor and overall calls per minute; 0 turns a limit off) ---
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_GLOBAL_PER_MINUTE=120
